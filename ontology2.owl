<?xml version="1.0"?>
<rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
         xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
         xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
         xmlns:owl="http://www.w3.org/2002/07/owl#"
         xml:base="http://example.org/menu-ontology"
         xmlns="http://example.org/menu-ontology#">

<owl:Ontology rdf:about="http://example.org/menu-ontology"/>

<owl:ObjectProperty rdf:about="#hasRating">
  <rdfs:domain rdf:resource="#Response"/>
  <rdfs:range rdf:resource="#Rating"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#hasIngredient">
  <rdfs:domain rdf:resource="#Dish"/>
  <rdfs:range rdf:resource="#Ingredient"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#usesTechnique">
  <rdfs:domain rdf:resource="#Dish"/>
  <rdfs:range rdf:resource="#Technique"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#hasCuisine">
  <rdfs:domain rdf:resource="#Dish"/>
  <rdfs:range rdf:resource="#Cuisine"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#hasTaste">
  <rdfs:domain rdf:resource="#Dish"/>
  <rdfs:range rdf:resource="#Taste"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#hasDietaryTag">
  <rdfs:domain rdf:resource="#Dish"/>
  <rdfs:range rdf:resource="#DietaryTag"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#hasHealthFlag">
  <rdfs:domain rdf:resource="#Dish"/>
  <rdfs:range rdf:resource="#HealthFlag"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#hasFirstCourse">
  <rdfs:domain rdf:resource="#Menu"/>
  <rdfs:range rdf:resource="#Dish"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#hasMainCourse">
  <rdfs:domain rdf:resource="#Menu"/>
  <rdfs:range rdf:resource="#Dish"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#hasDessert">
  <rdfs:domain rdf:resource="#Menu"/>
  <rdfs:range rdf:resource="#Dish"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#hasProblem">
  <rdfs:domain rdf:resource="#Case"/>
  <rdfs:range rdf:resource="#Query"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#hasSolution">
  <rdfs:domain rdf:resource="#Case"/>
  <rdfs:range rdf:resource="#Menu"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#requestedTechnique">
  <rdfs:domain rdf:resource="#Query"/>
  <rdfs:range rdf:resource="#Technique"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#hasSensoryGoal">
  <rdfs:domain rdf:resource="#Query"/>
  <rdfs:range rdf:resource="#SensoryGoal"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#forbidsIngredient">
  <rdfs:domain rdf:resource="#Query"/>
  <rdfs:range rdf:resource="#Ingredient"/>
</owl:ObjectProperty>

<owl:DatatypeProperty rdf:about="#ratingValue">
  <rdfs:domain rdf:resource="#Rating"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#feedback">
  <rdfs:domain rdf:resource="#Response"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#ingredientName">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#Ingredient"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#ingredientRole">
  <rdfs:domain rdf:resource="#Ingredient"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#dishName">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#Dish"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#description">
  <rdfs:domain rdf:resource="#Dish"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#courseType">
  <rdfs:domain rdf:resource="#Dish"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#primaryTaste">
  <rdfs:domain rdf:resource="#Dish"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#secondaryTaste">
  <rdfs:domain rdf:resource="#Dish"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#prepTime">
  <rdfs:domain rdf:resource="#Dish"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#cookTime">
  <rdfs:domain rdf:resource="#Dish"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#cookSpeed">
  <rdfs:domain rdf:resource="#Dish"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#difficulty">
  <rdfs:domain rdf:resource="#Dish"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#healthinessScore">
  <rdfs:domain rdf:resource="#Dish"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#healthLevel">
  <rdfs:domain rdf:resource="#Dish"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#justification">
  <rdfs:domain rdf:resource="#Dish"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#eventType">
  <rdfs:domain rdf:resource="#Query"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#season">
  <rdfs:domain rdf:resource="#Query"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#numberOfGuests">
  <rdfs:domain rdf:resource="#Query"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#presentationStyle">
  <rdfs:domain rdf:resource="#Query"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#queryDescription">
  <rdfs:domain rdf:resource="#Query"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#prepTimeConstraint">
  <rdfs:domain rdf:resource="#Query"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#healthinessLevelConstraint">
  <rdfs:domain rdf:resource="#Query"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#caseId">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#Case"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#rating">
  <rdfs:domain rdf:resource="#Case"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
</owl:DatatypeProperty>

<owl:Class rdf:about="#Ingredient">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
</owl:Class>

<owl:Class rdf:about="#Dish">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
</owl:Class>

<owl:Class rdf:about="#Menu">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
</owl:Class>

<owl:Class rdf:about="#Query">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
</owl:Class>

<owl:Class rdf:about="#Case">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
</owl:Class>

<owl:Class rdf:about="#Technique">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
</owl:Class>

<owl:Class rdf:about="#Cuisine">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
</owl:Class>

<owl:Class rdf:about="#Taste">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
</owl:Class>

<owl:Class rdf:about="#DietaryTag">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
</owl:Class>

<owl:Class rdf:about="#HealthFlag">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
</owl:Class>

<owl:Class rdf:about="#SensoryGoal">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
</owl:Class>

<owl:Class rdf:about="#Response">
  <rdfs:subClassOf rdf:resource="#Case"/>
</owl:Class>

<owl:Class rdf:about="#Rating">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
</owl:Class>


</rdf:RDF>
